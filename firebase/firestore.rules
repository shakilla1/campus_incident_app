rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function verifiedAlu() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@(alustudent|alueducation)\\.com');
    }

    function isStaff() {
      return verifiedAlu()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    match /users/{uid} {
      allow read: if verifiedAlu() && (request.auth.uid == uid || isStaff());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'student';
      allow update: if verifiedAlu()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
    }

    match /incidents/{incidentId} {
      allow read: if verifiedAlu();

      allow create: if verifiedAlu()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'Submitted';

      allow update: if isStaff()
        || (verifiedAlu()
            && resource.data.reportedBy == request.auth.uid
            && resource.data.status == 'Submitted'
            && request.resource.data.status == 'Submitted');

      allow delete: if verifiedAlu()
        && resource.data.reportedBy == request.auth.uid
        && resource.data.status == 'Submitted';
    }
  }
}
